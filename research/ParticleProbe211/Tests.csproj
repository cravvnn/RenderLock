<Project Sdk="Microsoft.NET.Sdk">
  <!-- RenderLock's particle simulation on unmodified Source 2 Viewer 21.1. The assembly is named and signed as the
       library's friend assembly so 21.1 itself needs no patch. Shipped behind ../ParticleSimulationProbe211.
       Build with -p:ParticleSimulationVrf211Source=<path to the 21.1 "src" folder>. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net11.0</TargetFramework><AssemblyName>Tests</AssemblyName><RootNamespace>Helper211</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>false</TreatWarningsAsErrors><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SignAssembly>true</SignAssembly><AssemblyOriginatorKeyFile>$(ParticleSimulationVrf211Source)/Misc/ValveResourceFormat.snk</AssemblyOriginatorKeyFile>
    <DefineConstants>$(DefineConstants);AGR_SIMULATION_SHADER_EXTRAS;AGR_SIMULATION_SNAPSHOT;AGR_SIMULATION_HITBOX;AGR_SIMULATION_BATCH;AGR_S2V_211</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup><Compile Include="*.cs" /></ItemGroup>
  <ItemGroup Condition="'$(ParticleSimulationVrf211Source)' != ''">
    <ProjectReference Include="$(ParticleSimulationVrf211Source)/ValveResourceFormat/ValveResourceFormat.csproj" />
  </ItemGroup>
  <Target Name="RequireVrf211Source" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ParticleSimulationVrf211Source)' == ''" Text="Set ParticleSimulationVrf211Source to the Source 2 Viewer 21.1 src folder." />
  </Target>
</Project>
