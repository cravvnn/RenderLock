<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);AGR_SIMULATION_SHADER_EXTRAS;AGR_SIMULATION_SNAPSHOT;AGR_SIMULATION_HITBOX;AGR_SIMULATION_BATCH</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ParticleProbe/*.cs" Exclude="../ParticleProbe/HitboxFrameHistory.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(ParticleSimulationVrfProject)' != ''">
    <ProjectReference Include="$(ParticleSimulationVrfProject)" />
  </ItemGroup>
  <Target Name="RequireIsolatedSimulationDependency" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ParticleSimulationVrfProject)' == ''" Text="Set ParticleSimulationVrfProject to the isolated pinned simulation dependency. Material extraction must keep its separately qualified parser." />
  </Target>
</Project>
