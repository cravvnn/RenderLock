[
  {
    "name": "drop cumulative budget",
    "replace": [
      [
        "(~keep \\/ rows<2)",
        "TRUE"
      ]
    ],
    "expect": "Bounded"
  },
  {
    "name": "crop pre-shot history",
    "replace": [
      [
        "keep == expected /\\ ~faultSeen",
        "keep == expected /\\ ~faultSeen /\\ position>0"
      ]
    ],
    "expect": "HistoryPreserved"
  },
  {
    "name": "drop changed owner rows",
    "replace": [
      [
        "keep == expected /\\ ~faultSeen",
        "keep == present /\\ selected /\\ ~faultSeen"
      ]
    ],
    "expect": "RetainOwnerChanges"
  },
  {
    "name": "accept truncated scan",
    "replace": [
      [
        "available'=(position=4 /\\ ~faultSeen)",
        "available'=(~faultSeen)"
      ]
    ],
    "expect": "Covered"
  },
  {
    "name": "overwrite competing output",
    "replace": [
      [
        "fresh == ~exists",
        "fresh == TRUE"
      ]
    ],
    "expect": "PreservePrior"
  },
  {
    "name": "accept failed flush",
    "replace": [
      [
        "IF exit=\"success\" /\\ content=\"complete\" /\\ available THEN TRUE ELSE accepted",
        "IF content=\"complete\" /\\ available THEN TRUE ELSE accepted"
      ]
    ],
    "expect": "AcceptedSuccess"
  },
  {
    "name": "keep failed prefix",
    "replace": [
      [
        "rows'=IF legal THEN rows+IF keep THEN 1 ELSE 0 ELSE 0",
        "rows'=IF legal THEN rows+IF keep THEN 1 ELSE 0 ELSE rows"
      ]
    ],
    "expect": "DiscardFailed"
  },
  {
    "name": "capture failure aborts actor callback",
    "replace": [
      [
        "actorRows'=actorRows+1",
        "actorRows'=actorRows+IF legal THEN 1 ELSE 0"
      ]
    ],
    "expect": "CoreIndependent"
  },
  {
    "name": "serialized budget failure advertised available",
    "replace": [
      [
        "available'=(available /\\ fits)",
        "available'=available"
      ]
    ],
    "expect": "Covered"
  },
  {
    "name": "retry capture after failure",
    "replace": [
      [
        "keep == expected /\\ ~faultSeen",
        "keep == expected"
      ]
    ],
    "expect": "DiscardFailed"
  }
]