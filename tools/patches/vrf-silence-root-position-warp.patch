+------------------------- MODULE RootPositionSetter -------------------------
+EXTENDS Integers, Naturals, TLC
+\* Complete mutable SetSingleControlPointPosition.Operate/Reset protocol,
+\* now also calling the separately modeled root position writer. Two setter
+\* instances share a target; each owns its own hasRunBefore flag. Root/child/
+\* identity predicate and numerical validation are immutable and checked by
+\* compiled oracles. Frame/writer math composes RootControlPointPosition.
+\* Synchronous calls only; fatal operator exceptions end the helper request.
+CONSTANT SetOnce
+Ops == 0..1
+VARIABLES ran, pos, refRan, refPos
+vars == <<ran,pos,refRan,refPos>>
+Init == /\ ran = [i \in Ops |-> FALSE] /\ refRan = ran
+        /\ pos = 0 /\ refPos = 0
+Operate(i,value) ==
+  LET run == ~(SetOnce /\ ran[i])
+      refRun == ~(SetOnce /\ refRan[i])
+  IN /\ ran' = IF run THEN [ran EXCEPT ![i] = TRUE] ELSE ran
+     /\ pos' = IF run THEN value ELSE pos
+     /\ refRan' = IF refRun THEN [refRan EXCEPT ![i] = TRUE] ELSE refRan
+     /\ refPos' = IF refRun THEN value ELSE refPos
+Reset(i) == /\ ran' = [ran EXCEPT ![i] = FALSE]
+            /\ refRan' = [refRan EXCEPT ![i] = FALSE]
+            /\ UNCHANGED <<pos,refPos>>
+Next == (\E i \in Ops,value \in 0..1: Operate(i,value)) \/ (\E i \in Ops: Reset(i))
+Spec == Init /\ [][Next]_vars
+Reference == ran = refRan /\ pos = refPos
+=============================================================================
