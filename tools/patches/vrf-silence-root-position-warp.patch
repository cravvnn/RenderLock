+namespace ValveResourceFormat.Particles.Initializers
+{
+    /// <summary>Scalar interpolation between literal warp vectors in a control
+    /// point's rigid frame. Current and previous positions are independent.</summary>
+    /// <remarks>No mutable initializer state. Existing numeric-provider and
+    /// collection clocks own scheduling; native prepared kernels cover math.</remarks>
+    class PositionWarpScalar : ParticleFunctionInitializer
+    {
+        private readonly Vector3 warpMin = Vector3.One;
+        private readonly Vector3 warpMax = Vector3.One;
+        private readonly INumberProvider inputValue = new LiteralNumberProvider(0);
+        private readonly float previousScale = 1;
+        private readonly int controlPoint;
+        private readonly int scaleControlPoint = -1;
+
+        public PositionWarpScalar(ParticleDefinitionParser parse) : base(parse)
+        {
+            warpMin = parse.Vector3("m_vecWarpMin", warpMin);
+            warpMax = parse.Vector3("m_vecWarpMax", warpMax);
+            inputValue = parse.NumberProvider("m_InputValue", inputValue);
+            previousScale = parse.Float("m_flPrevPosScale", previousScale);
+            controlPoint = parse.Int32("m_nControlPointNumber", controlPoint);
+            scaleControlPoint = parse.Int32("m_nScaleControlPointNumber", scaleControlPoint);
+            if (!Finite(warpMin) || !Finite(warpMax) || !float.IsFinite(previousScale)
+                || controlPoint is < 0 or > 63 || scaleControlPoint is < -1 or > 63)
+            {
+                throw new NotSupportedException("Scalar position warp requires finite vectors/scales and bounded control points.");
+            }
+        }
+
+        private static bool Finite(Vector3 v) => float.IsFinite(v.X) && float.IsFinite(v.Y) && float.IsFinite(v.Z);
+        public override ulong WrittenFields => FieldMask(ParticleField.Position) | FieldMask(ParticleField.PositionPrevious);
+
+        public override Particle Initialize(ref Particle particle, ParticleCollection particles, ParticleSystemState state)
+        {
+            var minimum = warpMin;
+            var maximum = warpMax;
+            if (scaleControlPoint >= 0)
+            {
+                var scale = state.GetControlPoint(scaleControlPoint).Position;
+                minimum *= scale;
+                maximum *= scale;
+            }
+            var value = inputValue.NextNumber(ref particle, state);
+            var warp = minimum + (maximum - minimum) * value;
+            var cp = state.GetControlPoint(controlPoint);
+            var q = cp.GetRotation();
+            if (!float.IsFinite(value) || !Finite(warp) || !Finite(cp.Position)
+                || !Finite(particle.Position) || !Finite(particle.PositionPrevious)
+                || !float.IsFinite(q.LengthSquared()) || MathF.Abs(q.LengthSquared() - 1) > 2e-5f)
+            {
+                throw new NotSupportedException("Scalar position warp requires finite inputs and a unit control-point rotation.");
+            }
+            var rotation = Matrix4x4.CreateFromQuaternion(q);
+            var inverseRotation = Matrix4x4.Transpose(rotation);
+            var local = Vector3.Transform(particle.Position - cp.Position, inverseRotation);
+            var localPrevious = Vector3.Transform(particle.PositionPrevious - cp.Position, inverseRotation);
+            var position = Vector3.Transform(local * warp, rotation) + cp.Position;
+            var previous = Vector3.Transform(localPrevious * warp * previousScale, rotation) + cp.Position;
+            if (!Finite(position) || !Finite(previous))
+            {
+                throw new NotSupportedException("Scalar position warp overflow.");
+            }
+            particle.Position = position;
+            particle.PositionPrevious = previous;
+            return particle;
+        }
+    }
+}
