+------------------- MODULE RootControlPointPosition -------------------
+EXTENDS Integers, Naturals, TLC
+\* Whole root-position-write component: new WriteAuthoredRootPosition and
+\* recursive WriteAuthoredPositionTree, called only by qualified literal
+\* SetSingleControlPointPosition on a root. External updates and frame history
+\* are the interface of existing Program/ParticleSystemState clock handling.
+\* Models inherited versus existing child-local points, identity, orientation,
+\* previous snapshots and repeated root/child writes. No new reset is inferred.
+\* Three fixed nodes (root/two children), two CPs and two finite pose values.
+\* Native recursive setter math and actual C# simulation checked separately.
+\* Does not model full particle simulation, native masks or provider acquisition.
+Nodes == 0..2
+CPs == 0..1
+Keys == Nodes \X CPs
+VARIABLES pos, basis, previous, authored, overrides,
+          refPos, refBasis, refPrevious, refAuthored, qualified, refQualified
+vars == <<pos,basis,previous,authored,overrides,refPos,refBasis,refPrevious,refAuthored,qualified,refQualified>>
+Init == /\ pos = [k \in Keys |-> 0]
+        /\ basis = [k \in Keys |-> 0]
+        /\ previous = pos
+        /\ authored = {}
+        /\ overrides = {<<1,1>>}
+        /\ refPos = pos /\ refBasis = basis
+        /\ refPrevious = previous /\ refAuthored = authored
+        /\ qualified = FALSE /\ refQualified = FALSE
+External(cp,value,rotation) ==
+  /\ pos' = [k \in Keys |-> IF k[2]=cp /\ k \notin overrides THEN value ELSE pos[k]]
+  /\ basis' = [k \in Keys |-> IF k[2]=cp /\ k \notin overrides THEN rotation ELSE basis[k]]
+  /\ refPos' = [k \in Keys |-> IF k[2]=cp /\ k \notin overrides THEN value ELSE refPos[k]]
+  /\ refBasis' = [k \in Keys |-> IF k[2]=cp /\ k \notin overrides THEN rotation ELSE refBasis[k]]
+  /\ UNCHANGED <<previous,authored,overrides,refPrevious,refAuthored,qualified,refQualified>>
+WriteAuthoredRootPosition(caller,cp,value) ==
+  LET allowed == caller=0
+      targets == {k \in Keys : k[2]=cp}
+  IN /\ qualified' = (qualified \/ allowed)
+     /\ refQualified' = (refQualified \/ (caller=0))
+     /\ pos' = [k \in Keys |-> IF allowed /\ k \in targets THEN value ELSE pos[k]]
+     /\ basis' = basis
+     /\ authored' = IF allowed THEN authored \cup targets ELSE authored
+     /\ refPos' = [k \in Keys |-> IF caller=0 /\ k[2]=cp THEN value ELSE refPos[k]]
+     /\ refBasis' = refBasis
+     /\ refAuthored' = IF caller=0 THEN refAuthored \cup {k \in Keys : k[2]=cp} ELSE refAuthored
+     /\ UNCHANGED <<previous,overrides,refPrevious>>
+Snapshot == /\ previous'=pos /\ refPrevious'=refPos
+            /\ UNCHANGED <<pos,basis,authored,overrides,refPos,refAuthored,refBasis,qualified,refQualified>>
+Next == (\E cp \in CPs,value \in 0..1,rotation \in 0..1: External(cp,value,rotation))
+        \/ (\E caller \in 0..2,cp \in CPs,value \in 0..1: WriteAuthoredRootPosition(caller,cp,value))
+        \/ Snapshot
+Spec == Init /\ [][Next]_vars
+Reference == /\ pos=refPos /\ basis=refBasis
+             /\ previous=refPrevious /\ authored=refAuthored /\ qualified=refQualified
+=====================================================================
