diff --git a/ValveResourceFormat/Particles/Operators/SetPerChildControlPoint.cs b/ValveResourceFormat/Particles/Operators/SetPerChildControlPoint.cs
new file mode 100644
--- /dev/null
+++ b/ValveResourceFormat/Particles/Operators/SetPerChildControlPoint.cs
@@ -0,0 +1,74 @@
+using Microsoft.Extensions.Logging;
+using ValveResourceFormat.Particles.Utils;
+using ValveResourceFormat.ResourceTypes;
+
+namespace ValveResourceFormat.Particles.Operators
+{
+    /// <summary>Assigns one particle position and optional velocity frame to each matching child subtree.</summary>
+    class SetPerChildControlPoint : ParticleFunctionOperator
+    {
+        private readonly int ChildGroupId;
+        private readonly int ControlPoint;
+        private readonly int Count;
+        private readonly int Increment;
+        private readonly bool SetOrientation;
+        private readonly bool Supported;
+        private readonly List<ParticleSystemState> MatchingChildren = [];
+
+        public SetPerChildControlPoint(ParticleDefinitionParser parse) : base(parse)
+        {
+            ChildGroupId = parse.Int32("m_nChildGroupID", 0);
+            ControlPoint = parse.Int32("m_nFirstControlPoint", 0);
+            Count = parse.Int32("m_nNumControlPoints", 1);
+            SetOrientation = parse.Boolean("m_bSetOrientation", false);
+            var first = parse.NumberProvider("m_nFirstSourcePoint", new LiteralNumberProvider(0f));
+            var increment = parse.NumberProvider("m_nParticleIncrement", new LiteralNumberProvider(1f));
+            Supported = ControlPoint is >= 0 and <= 63 && Count >= 0
+                && first is LiteralNumberProvider literalFirst && literalFirst.Value == 0f
+                && increment is LiteralNumberProvider literalIncrement && literalIncrement.Value is 1f or -1f
+                && !parse.Boolean("m_bNumAsCount", false)
+                && (SetOrientation || parse.Int32("m_nOrientation", 19) == 19);
+            Increment = increment is LiteralNumberProvider value ? (int)value.Value : 0;
+            if (!Supported)
+            {
+                parse.Logger.LogWarning("C_OP_SetPerChildControlPoint requires literal first source 0, increment +/-1, fixed child count, and velocity orientation or no orientation attribute");
+            }
+        }
+
+        public override void Operate(ParticleCollection particles, float frameTime, ParticleSystemState particleSystemState, float strength)
+        {
+            if (!Supported || particleSystemState.Data == null || particles.Count == 0)
+            {
+                return;
+            }
+
+            MatchingChildren.Clear();
+            particleSystemState.Data.CollectChildStatesInGroup(ChildGroupId, MatchingChildren);
+            var count = Math.Min(Count, Math.Min(particles.Count, MatchingChildren.Count));
+            var source = 0;
+            for (var index = 0; index < count; index++)
+            {
+                ref var particle = ref particles.Current[source];
+                var direction = particle.Position - particle.PositionPrevious;
+                Matrix4x4? basis = null;
+                if (SetOrientation && direction != Vector3.Zero)
+                {
+                    var length = direction.Length();
+                    if (!float.IsFinite(length) || length == 0f)
+                    {
+                        throw new InvalidOperationException("Per-child velocity direction must have a finite nonzero length");
+                    }
+
+                    basis = EntityTransformHelper.ParticleDirectionToRotationMatrix(direction / length);
+                }
+
+                MatchingChildren[index].WriteAuthoredChildTransform(ControlPoint, particle.Position, basis);
+                source += Increment;
+                if (source < 0)
+                {
+                    source += particles.Count;
+                }
+            }
+        }
+    }
+}
