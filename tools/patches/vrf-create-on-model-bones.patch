+using System.Numerics;
+
+namespace ValveResourceFormat.Particles;
+
+/// <summary>Prepared model-order world bone transform, in Source units.</summary>
+public readonly record struct ModelBonePose(Vector3 Position, Quaternion Rotation, float Scale);
+
+/// <summary>AGR's bounded bone-box sampling subset; no entity lookup or hitbox inference.</summary>
+public static class ModelBoneSampling
+{
+    /// <summary>Sample a bone box with explicit RNG consumption and volume sampling only.</summary>
+    public static (Vector3 Position, Vector3 Coordinates, int Index) Sample(
+        IReadOnlyList<ModelBonePose> bones, Vector3 origin, Vector3 scale, Vector3 bias, Func<bool, float> random)
+    {
+        if (bones.Count == 0) return (origin, Vector3.Zero, 0);
+        if (bones.Count > 32767 || !Finite(origin) || !Finite(scale) || !Finite(bias)
+            || scale.X < 0 || scale.Y < 0 || scale.Z < 0)
+            throw new InvalidOperationException("Invalid AGR bone sampling inputs");
+        float Draw(bool extra = false)
+        {
+            var value = random(extra);
+            if (!float.IsFinite(value) || value < 0 || value >= 1)
+                throw new InvalidOperationException("Invalid AGR bone sampling random value");
+            return value;
+        }
+        var high = scale * .5f + new Vector3(.5f);
+        var low = Vector3.One - high;
+        var biased = !(bias.X > -.0001f && bias.X < .0001f && bias.Y > -.0001f
+            && bias.Y < .0001f && bias.Z > -.0001f && bias.Z < .0001f);
+        var best = -1e20f;
+        (Vector3 Position, Vector3 Coordinates, int Index) selected = default;
+        for (var attempt = 0; attempt < (biased ? 6 : 1); attempt++)
+        {
+            var index = (int)(bones.Count * Draw());
+            var bone = bones[index];
+            if (!Finite(bone.Position) || !float.IsFinite(bone.Scale) || bone.Scale <= 0
+                || !float.IsFinite(bone.Rotation.LengthSquared()))
+                throw new InvalidOperationException("Invalid AGR model bone transform");
+            var uv = (high - low) * new Vector3(Draw(true), Draw(true), Draw(true)) + low;
+            var local = new Vector3(16) * uv - new Vector3(8);
+            var q = new Vector3(bone.Rotation.X, bone.Rotation.Y, bone.Rotation.Z);
+            var twiceCross = 2 * Vector3.Cross(q, local);
+            var point = (local + bone.Rotation.W * twiceCross + Vector3.Cross(q, twiceCross)) * bone.Scale + bone.Position;
+            var score = float.MaxValue;
+            if (biased)
+            {
+                var delta = point - origin;
+                score = ((delta.Z * bias.Z + delta.Y * bias.Y) + delta.X * bias.X) + Draw() * 72;
+            }
+            if (score > best) { best = score; selected = (point, uv, index); }
+        }
+        if (!Finite(selected.Position)) throw new InvalidOperationException("Nonfinite AGR bone sample");
+        return selected;
+    }
+
+    private static bool Finite(Vector3 value) => float.IsFinite(value.X) && float.IsFinite(value.Y) && float.IsFinite(value.Z);
+}
