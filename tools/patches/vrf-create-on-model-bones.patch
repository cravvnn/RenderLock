+namespace ValveResourceFormat.Particles.Initializers;
+
+/// <summary>AGR's explicit bone-only, literal-input model emission subset.</summary>
+class CreateOnModel : ParticleFunctionInitializer
+{
+    private readonly Vector3 scale;
+    private readonly Vector3 bias;
+
+    public CreateOnModel(ParticleDefinitionParser parse) : base(parse)
+    {
+        // Defaults checked against the installed constructor 0x17bf70.
+        if (!parse.Boolean("m_bUseBones") || parse.Boolean("m_bUseMesh")
+            || parse.Boolean("m_bEvenDistribution") || parse.Boolean("m_bScaleToVolume")
+            || parse.Boolean("m_bLocalCoords") || parse.Int32("m_nForceInModel") != 0
+            || parse.Int32("m_nHitboxValueFromControlPointIndex", -1) != -1
+            || parse.Float("m_flBoneVelocity") != 0 || parse.Float("m_flMaxBoneVelocity") != 0
+            || parse.Data.ContainsKey("m_modelInput") || parse.Data.ContainsKey("m_transformInput")
+            || parse.Data.ContainsKey("m_HitboxSetName"))
+            throw new NotSupportedException("AGR CreateOnModel requires default CP0 bone input, volume sampling, zero inherited velocity and no local/mesh/even/forced modes");
+        var desired = parse.NumberProvider("m_nDesiredHitbox", new LiteralNumberProvider(-1));
+        var shell = parse.NumberProvider("m_flShellSize", new LiteralNumberProvider(1));
+        var box = parse.VectorProvider("m_vecHitBoxScale", new LiteralVectorProvider(Vector3.One));
+        var direction = parse.VectorProvider("m_vecDirectionBias", new LiteralVectorProvider(Vector3.Zero));
+        if (desired is not LiteralNumberProvider || shell is not LiteralNumberProvider
+            || box is not LiteralVectorProvider || direction is not LiteralVectorProvider
+            || desired.NextNumber() != -1 || shell.NextNumber() != 1)
+            throw new NotSupportedException("AGR CreateOnModel requires literal scale/bias, no selected shape and shell size 1");
+        scale = box.NextVector(ParticleSystemState.Default);
+        bias = direction.NextVector(ParticleSystemState.Default);
+    }
+
+    // Native declaration for non-mesh mode, including creation time.
+    public override ulong WrittenFields => 0xc105;
+
+    public override Particle Initialize(ref Particle particle, ParticleCollection particles, ParticleSystemState state)
+    {
+        var sample = ModelBoneSampling.Sample(state.GetModelBones(0), state.GetControlPoint(0).Position,
+            scale, bias, extra => extra ? state.Random.NextModelCoordinate() : state.Random.Next());
+        particle.Position = sample.Position;
+        particle.PositionPrevious = sample.Position;
+        particle.Velocity = Vector3.Zero;
+        particle.HitboxOffsetPosition = sample.Coordinates;
+        particle.HitboxIndex = sample.Index;
+        return particle;
+    }
+}
