+using System.Collections.Immutable;
+using System.Numerics;
+
+namespace ValveResourceFormat.Particles;
+
+/// <summary>Qualified prepared CP hitbox sampling; provider acquisition is separate.</summary>
+public static class ModelHitboxSampling
+{
+    /// <summary>Transform local hitbox coordinates into Source-world coordinates.</summary>
+    public static Vector3 Point(AuthoredHitboxShape shape, Vector3 uv)
+    {
+        var local = (shape.Max - shape.Min) * uv + shape.Min;
+        var q = new Vector3(shape.Rotation.X, shape.Rotation.Y, shape.Rotation.Z);
+        var cross = 2 * Vector3.Cross(q, local);
+        return (local + shape.Rotation.W * cross + Vector3.Cross(q, cross)) * shape.Scale + shape.Position;
+    }
+
+    /// <summary>Sample supplied CP records with explicit random-draw consumption.</summary>
+    public static (Vector3 Position, Vector3 Coordinates, int Index) Sample(
+        ImmutableArray<AuthoredHitboxShape> shapes, Vector3 origin, Vector3 scale,
+        Vector3 bias, bool weighted, Func<bool, float> random)
+    {
+        if (shapes.IsDefaultOrEmpty || shapes.Length > 4096 || !Finite(origin) || !Finite(scale)
+            || !Finite(bias) || scale.X < 0 || scale.Y < 0 || scale.Z < 0)
+            throw new InvalidOperationException("Invalid explicit hitbox sample inputs");
+        var total = 0f;
+        foreach (var shape in shapes) total += shape.Weight;
+        if (!float.IsFinite(total) || (weighted && total <= 0)) throw new InvalidOperationException("Invalid hitbox weights");
+        float Draw(bool extra = false)
+        {
+            var value = random(extra);
+            if (!float.IsFinite(value) || value < 0 || value >= 1) throw new InvalidOperationException("Invalid hitbox random draw");
+            return value;
+        }
+        var high = scale * .5f + new Vector3(.5f); var low = Vector3.One - high;
+        var biased = !(bias.X > -.0001f && bias.X < .0001f && bias.Y > -.0001f && bias.Y < .0001f && bias.Z > -.0001f && bias.Z < .0001f);
+        var best = -1e20f; (Vector3 Position, Vector3 Coordinates, int Index) selected = default;
+        for (var attempt = 0; attempt < (biased ? 6 : 1); attempt++)
+        {
+            var index = (int)(shapes.Length * Draw());
+            if (weighted)
+            {
+                var target = total * Draw();
+                for (index = 0; index < shapes.Length - 1; index++) { target -= shapes[index].Weight; if (target <= 0) break; }
+            }
+            var shape = shapes[index];
+            var uv = (high - low) * new Vector3(Draw(true), Draw(true), Draw(true)) + low;
+            var point = Point(shape, uv); var score = float.MaxValue;
+            if (biased)
+            {
+                var delta = point - origin;
+                score = ((delta.Z * bias.Z + delta.Y * bias.Y) + delta.X * bias.X) + Draw() * 72;
+            }
+            if (score > best) { best = score; selected = (point, uv, index); }
+        }
+        if (!Finite(selected.Position)) throw new InvalidOperationException("Nonfinite authored hitbox sample");
+        return selected;
+    }
+
+    /// <summary>Apply the prepared non-rigid position/previous-position native kernel.</summary>
+    public static (Vector3 Position, Vector3 Previous) Lock(HitboxFrameHistory.Frame frame,
+        Vector3 position, Vector3 previous, int index, Vector3 uv, float age, float dt,
+        float start, float end, float strength, float previousScale, bool jumped)
+    {
+        if (frame.Current.Length == 0 || frame.Current.Length != frame.Previous.Length
+            || index < 0 || index >= frame.Current.Length) return (position, previous);
+        if (!float.IsFinite(dt) || dt <= 0 || !float.IsFinite(age) || age < 0 || !float.IsFinite(start) || !float.IsFinite(end)
+            || !float.IsFinite(strength) || strength < 0 || strength > 1 || !float.IsFinite(previousScale) || previousScale < 0 || previousScale > 1
+            || !Finite(position) || !Finite(previous) || !Finite(uv))
+            throw new InvalidOperationException("Invalid prepared hitbox lock input");
+        var cutoff = end <= 0 ? 1e20f : end;
+        if (!jumped && age >= cutoff) return (position, previous);
+        var amount = MathF.Min(age, dt) / dt;
+        if (!jumped && age > start)
+        {
+            var inverse = end > start ? 1 / (end - start) : 0;
+            amount = amount * (1 - (age - start) * inverse) * strength;
+        }
+        var delta = (Point(frame.Current[index], uv) - Point(frame.Previous[index], uv)) * amount;
+        var output = position + delta; var prior = previous + delta * (jumped ? 1 : previousScale);
+        if (!Finite(output) || !Finite(prior)) throw new InvalidOperationException("Hitbox lock overflow");
+        return (output, prior);
+    }
+
+    private static bool Finite(Vector3 v) => float.IsFinite(v.X) && float.IsFinite(v.Y) && float.IsFinite(v.Z);
+}
