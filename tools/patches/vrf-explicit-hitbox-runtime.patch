+using ValveResourceFormat.Serialization.KeyValues;
+
+namespace ValveResourceFormat.Particles;
+
+/// <summary>Only explicit CP model selection, without named/model/transform aliases.</summary>
+static class ModelHitboxInput
+{
+    internal static int ControlPoint(ParticleDefinitionParser parse)
+    {
+        if (!parse.Data.ContainsKey("m_modelInput")) return 0;
+        var input = parse.Data.GetSubCollection("m_modelInput");
+        if (!input.IsCollection || input.GetStringProperty("m_nType", "PM_TYPE_CONTROL_POINT") != "PM_TYPE_CONTROL_POINT")
+            throw new NotSupportedException("AGR requires an explicit control-point model input");
+        var nested = new ParticleDefinitionParser(input, parse.Logger, parse.InputOrdinal, parse.BehaviorVersion);
+        var cp = nested.Int32("m_nControlPoint");
+        if (cp < 0 || cp > 63) throw new NotSupportedException("Invalid authored model control point");
+        return cp;
+    }
+
+    // Current native bb300 CP branch + CreateOnModel's nonlocal origin pack.
+    // Model CP and transform CP are independent inputs, even when assets use 1/1.
+    internal static int TransformControlPoint(ParticleDefinitionParser parse)
+    {
+        if (!parse.Data.ContainsKey("m_transformInput")) return 0;
+        var input = parse.Data.GetSubCollection("m_transformInput");
+        if (!input.IsCollection || input.GetStringProperty("m_nType", "PT_TYPE_CONTROL_POINT") != "PT_TYPE_CONTROL_POINT")
+            throw new NotSupportedException("AGR requires a literal control-point emission transform");
+        var nested = new ParticleDefinitionParser(input, parse.Logger, parse.InputOrdinal, parse.BehaviorVersion);
+        var cp = nested.Int32("m_nControlPoint");
+        if (cp < 0 || cp > 63 || !nested.Boolean("m_bUseOrientation", true)
+            || nested.Boolean("m_bFollowNamedValue") || !string.IsNullOrEmpty(input.GetStringProperty("m_NamedValue", "")))
+            throw new NotSupportedException("Unsupported authored emission transform mode");
+        return cp;
+    }
+}
