+using ValveResourceFormat.Serialization.KeyValues;
+
+namespace ValveResourceFormat.Particles.Operators;
+
+/// <summary>Non-rigid CP hitbox position lock. Missing providers remain errors.</summary>
+class LockToBone : ParticleFunctionOperator
+{
+    private readonly int controlPoint;
+    private readonly string hitboxSet;
+    private readonly float fadeStart, fadeEnd, previousScale, jumpThreshold;
+
+    public LockToBone(ParticleDefinitionParser parse) : base(parse)
+    {
+        if (parse.Boolean("m_bRigid") || parse.Boolean("m_bUseBones") || parse.Boolean("m_bRigidRotationLock")
+            || parse.Int32("m_nRotationSetType") != 0 || parse.Int32("m_nFieldOutput") != 0
+            || parse.Int32("m_nFieldOutputPrev", 2) != 2 || parse.Data.ContainsKey("m_transformInput")
+            || parse.Data.ContainsKey("m_vecRotation") || parse.Data.ContainsKey("m_flRotLerp"))
+            throw new NotSupportedException("AGR LockToBone requires default position fields and non-rigid hitbox mode");
+        controlPoint = ModelHitboxInput.ControlPoint(parse);
+        hitboxSet = parse.Data.GetStringProperty("m_HitboxSetName", "");
+        fadeStart = parse.Float("m_flLifeTimeFadeStart"); fadeEnd = parse.Float("m_flLifeTimeFadeEnd");
+        previousScale = parse.Float("m_flPrevPosScale", 1); jumpThreshold = parse.Float("m_flJumpThreshold", 100);
+        if (!float.IsFinite(fadeStart) || !float.IsFinite(fadeEnd) || !float.IsFinite(previousScale)
+            || previousScale < 0 || previousScale > 1 || !float.IsFinite(jumpThreshold) || jumpThreshold < 0)
+            throw new NotSupportedException("Invalid LockToBone scalar controls");
+    }
+
+    public override void Operate(ParticleCollection particles, float frameTime, ParticleSystemState state, float strength)
+    {
+        var frame = state.GetModelHitboxes(controlPoint, hitboxSet, false);
+        if (frame.Current.Length == 0 || frame.Current.Length != frame.Previous.Length) return;
+        var jumped = state.GetControlPoint(0).StepDelta.LengthSquared() > jumpThreshold;
+        foreach (ref var particle in particles.Current)
+        {
+            var result = ModelHitboxSampling.Lock(frame, particle.Position, particle.PositionPrevious,
+                particle.HitboxIndex, particle.HitboxOffsetPosition, particle.Age, frameTime,
+                fadeStart, fadeEnd, strength, previousScale, jumped);
+            particle.Position = result.Position; particle.PositionPrevious = result.Previous;
+        }
+    }
+}
