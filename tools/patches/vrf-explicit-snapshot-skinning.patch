+---------------------- MODULE SnapshotSkinningRuntime ----------------------
+EXTENDS Integers, Sequences, TLC
+\* Entire new immutable per-particle ownership path: registered snapshot init ->
+\* EmitParticle final initial-copy -> registered rigid operator. Existing
+\* ParticleCollection compaction and Add/template-reset carry the new property.
+\* Synchronous spawn+initial copy are grouped: there is no observer or interleave
+\* between them in EmitParticle. SnapshotRowCursor independently checks the two
+\* initializer contexts, modulo and reset. Native math/field acquisition and
+\* future model-frame request admission are separate code/oracle obligations.
+\* Bounds: capacity2, total3spawns, oneclear; binding A/B. Transform is abstract
+\* x+10 solely to distinguish literal INITIAL previous from current or zero.
+VARIABLES current, initial, nextId, provider, clears, phase
+vars == <<current,initial,nextId,provider,clears,phase>>
+Init == /\ current = <<>> /\ initial = <<>> /\ nextId = 1
+        /\ provider = "A" /\ clears = 0 /\ phase = "active"
+Spawn ==
+  LET particle == [id |-> nextId, owner |-> nextId, binding |-> provider,
+                   usedBinding |-> provider, previous |-> nextId+100, updated |-> FALSE]
+  IN /\ phase = "active" /\ Len(current)<2 /\ nextId<=3
+     /\ current' = Append(current,particle)
+     /\ initial' = Append(initial,particle)
+     /\ nextId' = nextId+1
+     /\ UNCHANGED <<provider,clears,phase>>
+Update ==
+  LET valid == \A i \in 1..Len(current): current[i].binding = provider
+  IN /\ phase = "active" /\ Len(current)>0
+     /\ phase' = IF valid THEN "active" ELSE "rejected"
+     /\ current' = IF valid THEN
+          [i \in 1..Len(current) |-> [current[i] EXCEPT
+             !.previous = initial[i].previous+10, !.usedBinding = provider, !.updated = TRUE]]
+          ELSE current
+     /\ UNCHANGED <<initial,nextId,provider,clears>>
+Prune == /\ phase = "active" /\ Len(current)=2
+         /\ current' = Tail(current) /\ initial' = Tail(initial)
+         /\ UNCHANGED <<nextId,provider,clears,phase>>
+Clear == /\ phase = "active" /\ clears=0
+         /\ current' = <<>> /\ initial' = <<>> /\ clears' = 1
+         /\ UNCHANGED <<nextId,provider,phase>>
+ChangeProvider == /\ phase = "active" /\ provider' \in {"A","B"}
+                  /\ UNCHANGED <<current,initial,nextId,clears,phase>>
+Next == Spawn \/ Update \/ Prune \/ Clear \/ ChangeProvider
+Spec == Init /\ [][Next]_vars
+Aligned == /\ Len(current) = Len(initial)
+           /\ \A i \in 1..Len(current):
+                /\ current[i].id = initial[i].id
+                /\ current[i].owner = current[i].id
+                /\ initial[i].owner = initial[i].id
+LiteralInitial == \A i \in 1..Len(current):
+    ~current[i].updated \/ current[i].previous = initial[i].previous+10
+StableModel == \A i \in 1..Len(current): current[i].usedBinding = current[i].binding
+============================================================================
