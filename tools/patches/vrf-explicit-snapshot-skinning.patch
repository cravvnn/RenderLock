+namespace ValveResourceFormat.Particles;
+
+/// <summary>
+/// One initializer's qualified non-random snapshot-row context, increment 1 and
+/// no full-loop increment. Model/snapshot lookup and restart timing are separate.
+/// </summary>
+public sealed class SnapshotRowCursor
+{
+    private readonly int start;
+    private int position;
+
+    /// <summary>Current context value, before the next native modulo operation.</summary>
+    public int Position => position;
+
+    /// <summary>Constructs a separate initializer context with an explicit start.</summary>
+    public SnapshotRowCursor(int start = 0)
+    {
+        ArgumentOutOfRangeException.ThrowIfNegative(start);
+        this.start = start;
+        Reset();
+    }
+
+    /// <summary>Initializes this context as native InitializeContext does.</summary>
+    public void Reset() => position = start;
+
+    /// <summary>Read cursor modulo row count, then store that row plus one.</summary>
+    public int Take(int rowCount)
+    {
+        ArgumentOutOfRangeException.ThrowIfNegativeOrZero(rowCount);
+        var row = position % rowCount;
+        position = row + 1;
+        return row;
+    }
+}
