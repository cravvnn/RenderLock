+------------------------ MODULE SnapshotRowCursor ------------------------
+EXTENDS Integers, Naturals, TLC
+\* Entire new default non-random, increment1/fullLoop0 cursor component.
+\* Each C_INIT snapshot initializer owns one context, not a global particle id.
+\* Reset maps native context-init leaf; Take maps actual load/row-prefix/store.
+\* Restart timing/CP binding/full initializer stay outside this component.
+CONSTANT Start
+Contexts == {0,1}
+VARIABLES position, reference, last, refLast
+vars == <<position,reference,last,refLast>>
+Key(context) == context
+Init == /\ position=[c \in Contexts |-> Start]
+        /\ reference=position /\ last=[c \in Contexts |-> -1] /\ refLast=last
+Reset(context) ==
+  /\ position'=[position EXCEPT ![Key(context)]=Start]
+  /\ reference'=[reference EXCEPT ![context]=Start]
+  /\ UNCHANGED <<last,refLast>>
+Take(context,count) ==
+  LET valid == count>0
+      row == IF count#0 THEN position[Key(context)]%(IF count>0 THEN count ELSE -count) ELSE -1
+      refRow == IF valid THEN reference[context]%count ELSE -1
+  IN /\ position'=IF valid THEN [position EXCEPT ![Key(context)]=row+1] ELSE position
+     /\ reference'=IF count>0 THEN [reference EXCEPT ![context]=refRow+1] ELSE reference
+     /\ last'=IF valid THEN [last EXCEPT ![context]=row] ELSE last
+     /\ refLast'=IF count>0 THEN [refLast EXCEPT ![context]=refRow] ELSE refLast
+Next == (\E context \in Contexts: Reset(context))
+        \/ (\E context \in Contexts,count \in -1..3: Take(context,count))
+Spec == Init /\ [][Next]_vars
+Reference == /\ position=reference /\ last=refLast
+==========================================================================
