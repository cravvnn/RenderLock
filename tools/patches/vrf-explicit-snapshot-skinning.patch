+using System;
+using System.Numerics;
+
+namespace ValveResourceFormat.Particles.Utils
+{
+    /// <summary>
+    /// Prepared Source 3x4 skinning matrix, with column-vector rows in Source units.
+    /// Model identity, bone order, CP selection and pose acquisition belong to the caller.
+    /// This is deliberately distinct from System.Numerics' row-vector Matrix4x4.
+    /// </summary>
+    public readonly struct SnapshotSkinningMatrix
+    {
+        private readonly Vector4 x;
+        private readonly Vector4 y;
+        private readonly Vector4 z;
+
+        /// <summary>Copies twelve finite values in Source row-major 3x4 order.</summary>
+        public SnapshotSkinningMatrix(ReadOnlySpan<float> rows)
+        {
+            if (rows.Length != 12)
+            {
+                throw new ArgumentException("Snapshot skinning matrix requires twelve row-major values.", nameof(rows));
+            }
+
+            foreach (var value in rows)
+            {
+                if (!float.IsFinite(value))
+                {
+                    throw new ArgumentException("Snapshot skinning matrix must be finite.", nameof(rows));
+                }
+            }
+
+            x = new(rows[0], rows[1], rows[2], rows[3]);
+            y = new(rows[4], rows[5], rows[6], rows[7]);
+            z = new(rows[8], rows[9], rows[10], rows[11]);
+        }
+
+        /// <summary>Transforms a finite Source point, refusing numerical overflow.</summary>
+        public Vector3 TransformPoint(Vector3 point)
+        {
+            SnapshotSkinningMath.RequireFinite(point);
+            var result = new Vector3(
+                ((x.X * point.X + x.Y * point.Y) + x.Z * point.Z) + x.W,
+                ((y.X * point.X + y.Y * point.Y) + y.Z * point.Z) + y.W,
+                ((z.X * point.X + z.Y * point.Y) + z.Z * point.Z) + z.W);
+            SnapshotSkinningMath.RequireFinite(result);
+            return result;
+        }
+    }
+
+    /// <summary>
+    /// Qualified prepared position kernels only: zero bone/normal velocity and no
+    /// color, alpha, radius or normal copying. No operator is registered by this class.
+    /// InitialPrevious is the actual initial attribute supplied by the caller; it is
+    /// not inferred from velocity, zeroed, or converted between spaces here.
+    /// </summary>
+    public static class SnapshotSkinningMath
+    {
+        /// <summary>Returns the prepared zero-velocity initialization position pair.</summary>
+        public static (Vector3 Position, Vector3 Previous) InitializePositionPair(
+            Vector3 snapshotPosition, SnapshotSkinningMatrix? skinning, bool rigid)
+        {
+            RequireFinite(snapshotPosition);
+            // Native rigid initialization starts both positions at zero. With no
+            // valid bone, non-rigid initialization uses the identity transform.
+            var position = rigid ? Vector3.Zero : skinning?.TransformPoint(snapshotPosition) ?? snapshotPosition;
+            return (position, position);
+        }
+
+        /// <summary>Updates a prepared pair with the literal supplied initial previous attribute.</summary>
+        public static (Vector3 Position, Vector3 Previous) UpdatePositionPair(
+            Vector3 snapshotPosition, Vector3 initialPrevious, SnapshotSkinningMatrix? skinning,
+            Vector3 position, Vector3 previous)
+        {
+            RequireFinite(snapshotPosition);
+            RequireFinite(initialPrevious);
+            RequireFinite(position);
+            RequireFinite(previous);
+            if (!skinning.HasValue)
+            {
+                // Unlike initialization, a failed bone lookup leaves both outputs alone.
+                return (position, previous);
+            }
+
+            return (skinning.Value.TransformPoint(snapshotPosition),
+                skinning.Value.TransformPoint(snapshotPosition + initialPrevious));
+        }
+
+        internal static void RequireFinite(Vector3 value)
+        {
+            if (!float.IsFinite(value.X) || !float.IsFinite(value.Y) || !float.IsFinite(value.Z))
+            {
+                throw new ArgumentException("Snapshot position input or result is not finite.");
+            }
+        }
+    }
+}
