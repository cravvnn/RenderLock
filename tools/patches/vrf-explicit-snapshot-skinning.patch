+using ValveResourceFormat.Blocks;
+using ValveResourceFormat.Particles.Utils;
+using System.Linq;
+
+namespace ValveResourceFormat.Particles.Initializers;
+
+/// <summary>Qualified sequential single-bone, zero-velocity snapshot initialization.</summary>
+class InitSkinnedPositionFromCPSnapshot : ParticleFunctionInitializer
+{
+    private readonly int snapshotControlPoint;
+    private readonly int modelControlPoint;
+    private readonly SnapshotRowCursor cursor;
+
+    public InitSkinnedPositionFromCPSnapshot(ParticleDefinitionParser parse) : base(parse)
+    {
+        snapshotControlPoint = parse.Int32("m_nSnapshotControlPointNumber", 1);
+        modelControlPoint = parse.Int32("m_nControlPointNumber", 0);
+        if (snapshotControlPoint is < 0 or > 63 || modelControlPoint is < 0 or > 63
+            || parse.Boolean("m_bRandom") || parse.Int32("m_nRandomSeed") != 0
+            || parse.Boolean("m_bRigid") || parse.Boolean("m_bSetNormal") || parse.Boolean("m_bIgnoreDt")
+            || parse.Boolean("m_bCopyColor") || parse.Boolean("m_bCopyAlpha") || parse.Boolean("m_bSetRadius")
+            || parse.Float("m_flMinNormalVelocity") != 0 || parse.Float("m_flMaxNormalVelocity") != 0
+            || parse.Float("m_flBoneVelocity") != 0 || parse.Float("m_flBoneVelocityMax") != 0
+            || parse.Int32("m_nIndexType") != 0 || parse.Float("m_flIncrement", 1) != 1
+            || parse.Int32("m_nFullLoopIncrement") != 0 || parse.Data.ContainsKey("m_flReadIndex")
+            || parse.Data.ContainsKey("m_strSnapshotSubset"))
+            throw new NotSupportedException("AGR skinned snapshot requires sequential rows, zero inherited velocity and default copy/normal modes");
+        cursor = new SnapshotRowCursor(parse.Int32("m_nSnapShotStartPoint", 0));
+    }
+
+    public override ulong WrittenFields => 0x180008005UL;
+    public override void Reset() => cursor.Reset();
+
+    public override Particle Initialize(ref Particle particle, ParticleCollection particles, ParticleSystemState state)
+    {
+        var snapshot = state.GetControlPointSnapshot(snapshotControlPoint)
+            ?? throw new InvalidOperationException("AGR skinned snapshot CP has no snapshot");
+        var positions = snapshot.AttributeData.Where(p => p.Key.Name == "position").Select(p => p.Value).ToArray();
+        var skinning = snapshot.AttributeData.Where(p => p.Key.Name == "skinning").Select(p => p.Value).ToArray();
+        if (positions.Length != 1 || skinning.Length != 1 || positions[0] is not Vector3[] points
+            || skinning[0] is not ParticleSnapshot.SkinningData[] skins || points.Length == 0
+            || points.Length != skins.Length || points.Length != snapshot.NumParticles)
+            throw new InvalidOperationException("AGR skinned snapshot needs complete unique position/skinning columns");
+        var row = cursor.Take(points.Length);
+        var skin = skins[row];
+        if (skin.JointNames.Length != 4 || skin.Weights.Length != 4
+            || string.IsNullOrEmpty(skin.JointNames[0])
+            || skin.Weights[0] != 1 || skin.Weights.Skip(1).Any(w => w != 0))
+            throw new NotSupportedException("AGR skinned snapshot currently requires one explicit unit-weight bone per row");
+        var binding = state.GetSnapshotModelBone(modelControlPoint, skin.JointNames[0]);
+        var input = new SnapshotSkinningInput(modelControlPoint, skin.JointNames[0], binding.Identity);
+        var pair = SnapshotSkinningMath.InitializePositionPair(points[row], binding.Matrix, rigid: false);
+        particle.HitboxOffsetPosition = points[row];
+        particle.Position = pair.Position;
+        particle.PositionPrevious = pair.Previous;
+        particle.Velocity = Vector3.Zero;
+        particle.SnapshotSkinningInput = input;
+        return particle;
+    }
+}
