+using ValveResourceFormat.Particles.Utils;
+using System.Linq;
+
+namespace ValveResourceFormat.Particles;
+
+/// <summary>Explicit model-order bone-to-world * inverse-rest input for one named bone.</summary>
+public readonly record struct SnapshotModelBinding(string Identity, SnapshotSkinningMatrix Matrix);
+
+/// <summary>
+/// Immutable per-particle ownership, copied with the particle through compaction.
+/// The rest position remains the native hitbox-offset attribute, not a second
+/// hidden position. InitialPrevious remains the literal initialized attribute.
+/// </summary>
+public sealed record SnapshotSkinningInput
+{
+    /// <summary>Model provider control point, separate from the snapshot control point.</summary>
+    public int ControlPoint { get; }
+    /// <summary>Exact model-order bone name from the authored snapshot.</summary>
+    public string BoneName { get; }
+    /// <summary>Stable replay entity, model, bone order and named-bone binding identity.</summary>
+    public string BindingIdentity { get; }
+
+    /// <summary>Validate and retain explicit per-particle bone ownership.</summary>
+    public SnapshotSkinningInput(int controlPoint, string boneName, string bindingIdentity)
+    {
+        if (controlPoint is < 0 or > 63 || string.IsNullOrEmpty(boneName) || boneName.Length > 256
+            || string.IsNullOrEmpty(bindingIdentity) || bindingIdentity.Length != 64 || bindingIdentity.Any(c => !char.IsAsciiHexDigit(c)))
+            throw new ArgumentException("Snapshot skinning requires explicit CP, named bone and model binding hash");
+        ControlPoint = controlPoint;
+        BoneName = boneName;
+        BindingIdentity = bindingIdentity;
+    }
+
+    /// <summary>Read this frame's matrix while refusing a changed model binding.</summary>
+    public SnapshotSkinningMatrix RequireCurrentMatrix(ParticleSystemState state)
+    {
+        var current = state.GetSnapshotModelBone(ControlPoint, BoneName);
+        if (current.Identity != BindingIdentity)
+            throw new InvalidOperationException("Snapshot skinning model/bone binding changed after initialization");
+        return current.Matrix;
+    }
+}
