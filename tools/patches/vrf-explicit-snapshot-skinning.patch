+using ValveResourceFormat.Particles.Utils;
+
+namespace ValveResourceFormat.Particles.Operators;
+
+/// <summary>Qualified position-pair update; no guessed previous-position normalization.</summary>
+class SnapshotRigidSkinToBones : ParticleFunctionOperator
+{
+    private readonly int modelControlPoint;
+
+    public SnapshotRigidSkinToBones(ParticleDefinitionParser parse) : base(parse)
+    {
+        modelControlPoint = parse.Int32("m_nControlPointNumber", 0);
+        if (modelControlPoint is < 0 or > 63 || parse.Boolean("m_bTransformNormals") || parse.Boolean("m_bTransformRadii"))
+            throw new NotSupportedException("AGR rigid snapshot currently supports position pairs without normal/radius transforms");
+    }
+
+    public override void Operate(ParticleCollection particles, float frameTime, ParticleSystemState state, float strength)
+    {
+        if (strength != 1)
+            throw new NotSupportedException("AGR rigid snapshot currently requires full operator strength");
+        for (var index = 0; index < particles.Count; index++)
+        {
+            ref var particle = ref particles.Current[index];
+            var input = particle.SnapshotSkinningInput
+                ?? throw new InvalidOperationException("AGR rigid snapshot particle lacks initialized bone ownership");
+            if (input.ControlPoint != modelControlPoint)
+                throw new InvalidOperationException("AGR rigid snapshot model CP differs from its initializer");
+            var matrix = input.RequireCurrentMatrix(state);
+            var pair = SnapshotSkinningMath.UpdatePositionPair(particle.HitboxOffsetPosition,
+                particles.Initial[index].PositionPrevious, matrix, particle.Position, particle.PositionPrevious);
+            particle.Position = pair.Position;
+            particle.PositionPrevious = pair.Previous;
+        }
+    }
+}
