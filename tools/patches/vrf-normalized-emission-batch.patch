+-------------------------- MODULE EmitterBatch --------------------------
+EXTENDS Naturals, Integers, TLC
+CONSTANT Contexts, Capacity
+VARIABLES phase, count, pending, requested, batch, baseCount, initialized,
+          copied, callbackActive, observed, published
+vars == <<phase,count,pending,requested,batch,baseCount,initialized,copied,callbackActive,observed,published>>
+\* Entire new Emit/Collect/Detach/Reserve/Initialize/Copy/Publish protocol.
+\* Two independent synchronous simulations may interleave. Restart/prune occur
+\* only at caller frame boundaries; initializer exceptions are fatal to the
+\* owning helper instance, not a recoverable partial publish. Native numeric
+\* provider and saved-scene checks are separate from this finite state model.
+Init == /\ phase = [c \in Contexts |-> "idle"]
+        /\ count \in [Contexts -> 0..Capacity]
+        /\ pending = [c \in Contexts |-> 0]
+        /\ requested = [c \in Contexts |-> 0]
+        /\ batch = [c \in Contexts |-> 0]
+        /\ baseCount = count
+        /\ initialized = [c \in Contexts |-> 0]
+        /\ copied = [c \in Contexts |-> 0]
+        /\ callbackActive = [c \in Contexts |-> FALSE]
+        /\ observed = [c \in Contexts |-> -1]
+        /\ published = [c \in Contexts |-> FALSE]
+Begin(c) == /\ phase[c] = "idle"
+            /\ phase' = [phase EXCEPT ![c] = "collect"]
+            /\ pending' = [pending EXCEPT ![c] = 0]
+            /\ callbackActive' = [callbackActive EXCEPT ![c] = TRUE]
+            /\ published' = [published EXCEPT ![c] = FALSE]
+            /\ UNCHANGED <<count,requested,batch,baseCount,initialized,copied,observed>>
+Collect(c) == /\ phase[c] = "collect" /\ pending[c] < Capacity-count[c]
+              /\ pending' = [pending EXCEPT ![c] = @+1]
+              /\ requested' = [requested EXCEPT ![c] = @+1]
+              /\ UNCHANGED <<phase,count,batch,baseCount,initialized,copied,callbackActive,observed,published>>
+Detach(c) == /\ phase[c] = "collect"
+             /\ phase' = [phase EXCEPT ![c] = "reserve"]
+             /\ batch' = [batch EXCEPT ![c] = pending[c]]
+             /\ pending' = [pending EXCEPT ![c] = 0]
+             /\ callbackActive' = [callbackActive EXCEPT ![c] = FALSE]
+             /\ baseCount' = [baseCount EXCEPT ![c] = count[c]]
+             /\ initialized' = [initialized EXCEPT ![c] = 0]
+             /\ copied' = [copied EXCEPT ![c] = 0]
+             /\ observed' = [observed EXCEPT ![c] = -1]
+             /\ UNCHANGED <<count,requested,published>>
+Reserve(c) == /\ phase[c] = "reserve"
+              /\ count' = [count EXCEPT ![c] = @+batch[c]]
+              /\ phase' = [phase EXCEPT ![c] = "initialize"]
+              /\ UNCHANGED <<pending,requested,batch,baseCount,initialized,copied,callbackActive,observed,published>>
+Initialize(c) == /\ phase[c] = "initialize" /\ initialized[c] < batch[c]
+                 /\ initialized' = [initialized EXCEPT ![c] = @+1]
+                 /\ copied' = [copied EXCEPT ![c] = @+1]
+                 /\ observed' = [observed EXCEPT ![c] = count[c]]
+                 /\ UNCHANGED <<phase,count,pending,requested,batch,baseCount,callbackActive,published>>
+Publish(c) == /\ phase[c] = "initialize" /\ initialized[c] = batch[c]
+              /\ published' = [published EXCEPT ![c] = TRUE]
+              /\ phase' = [phase EXCEPT ![c] = "done"]
+              /\ UNCHANGED <<count,pending,requested,batch,baseCount,initialized,copied,callbackActive,observed>>
+FaultCollect(c) == /\ phase[c] = "collect"
+                   /\ phase' = [phase EXCEPT ![c] = "failed"]
+                   /\ callbackActive' = [callbackActive EXCEPT ![c] = FALSE]
+                   /\ pending' = [pending EXCEPT ![c] = 0]
+                   /\ UNCHANGED <<count,requested,batch,baseCount,initialized,copied,observed,published>>
+FaultInitialize(c) == /\ phase[c] = "initialize"
+                      /\ phase' = [phase EXCEPT ![c] = "failed"]
+                      /\ UNCHANGED <<count,pending,requested,batch,baseCount,initialized,copied,callbackActive,observed,published>>
+Prune(c) == /\ phase[c] = "idle" /\ count[c] > 0
+            /\ count' = [count EXCEPT ![c] = @-1]
+            /\ UNCHANGED <<phase,pending,requested,batch,baseCount,initialized,copied,callbackActive,observed,published>>
+Replay(c) == /\ phase[c] = "idle"
+             /\ count' = [count EXCEPT ![c] = 0]
+             /\ UNCHANGED <<phase,pending,requested,batch,baseCount,initialized,copied,callbackActive,observed,published>>
+Hold == /\ \A c \in Contexts: phase[c] \in {"done","failed"} /\ UNCHANGED vars
+Next == (\E c \in Contexts: Begin(c) \/ Collect(c) \/ Detach(c) \/ Reserve(c) \/ Initialize(c)
+           \/ Publish(c) \/ FaultCollect(c) \/ FaultInitialize(c) \/ Prune(c) \/ Replay(c)) \/ Hold
+Spec == Init /\ [][Next]_vars
+CapacityBound == \A c \in Contexts: count[c] <= Capacity /\ pending[c]+count[c] <= Capacity
+PendingOwned == \A c \in Contexts: phase[c] # "collect" => ~callbackActive[c]
+RequestsKept == \A c \in Contexts: phase[c] = "collect" => pending[c] = requested[c]
+BatchKept == \A c \in Contexts: phase[c] \in {"reserve","initialize","done"} => batch[c] = requested[c]
+CountReserved == \A c \in Contexts: phase[c] \in {"initialize","done"} => count[c] = baseCount[c]+batch[c]
+FinalCount == \A c \in Contexts: phase[c] \in {"initialize","done"} /\ initialized[c] > 0 => observed[c] = baseCount[c]+batch[c]
+CompleteCopies == \A c \in Contexts: published[c] => initialized[c] = batch[c] /\ copied[c] = batch[c]
+==========================================================================
