+--------------------------- MODULE PrewarmEmission ---------------------------
+EXTENDS Naturals, Integers, TLC
+\* BeginPrewarm/EndPrewarm counter scope, now using the separately modeled
+\* EmitBatch. Honest caller is pinned Renderer/Particles/ParticleRenderer.Prewarm,
+\* which either gets null, renders then ends, or throws before EndPrewarm.
+\* The helper does not render; compiled oracle exercises this public API.
+\* Initializer/render exceptions are fatal/failed here, not claimed restored.
+\* RNG state, graphics resources and complete renderer lifecycle are out of scope.
+CONSTANT InitialCount
+VARIABLES phase, count, serial, reported, savedSerial, savedReported, issued
+vars == <<phase,count,serial,reported,savedSerial,savedReported,issued>>
+Init == /\ phase="idle" /\ count=InitialCount /\ serial \in 0..1 /\ reported \in 0..1
+        /\ savedSerial=serial /\ savedReported=reported /\ issued=FALSE
+BeginPrewarm(n) ==
+  /\ phase="idle"
+  /\ phase'=IF count>0 THEN "no-scope" ELSE "initializing"
+  /\ count'=IF count>0 THEN count ELSE n
+  /\ serial'=IF count>0 THEN serial ELSE serial+n
+  /\ reported'=IF count>0 THEN reported ELSE n
+  /\ savedSerial'=serial /\ savedReported'=reported
+  /\ UNCHANGED issued
+ReturnScope == /\ phase="initializing" /\ phase'="borrowed" /\ issued'=TRUE
+               /\ UNCHANGED <<count,serial,reported,savedSerial,savedReported>>
+EndPrewarm == /\ phase="borrowed" /\ phase'="ended"
+              /\ count'=0 /\ serial'=savedSerial /\ reported'=savedReported
+              /\ UNCHANGED <<savedSerial,savedReported,issued>>
+Fail == /\ phase \in {"initializing","borrowed"} /\ phase'="failed"
+        /\ UNCHANGED <<count,serial,reported,savedSerial,savedReported,issued>>
+Terminal == /\ phase \in {"no-scope","ended","failed"} /\ UNCHANGED vars
+Next == (\E n \in 0..2:BeginPrewarm(n)) \/ ReturnScope \/ EndPrewarm \/ Fail \/ Terminal
+Spec == Init /\ [][Next]_vars
+Restored == phase#"ended" \/ (count=0 /\ serial=savedSerial /\ reported=savedReported)
+EmptyOnly == phase \in {"idle","no-scope","failed"} \/ InitialCount=0
+NoScope == phase#"no-scope" \/ (~issued /\ count=1 /\ serial=savedSerial /\ reported=savedReported)
+NoEarlyScope == phase#"initializing" \/ ~issued
+=============================================================================
--- /dev/null
