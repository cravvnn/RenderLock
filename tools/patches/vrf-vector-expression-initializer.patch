+namespace ValveResourceFormat.Particles.Initializers;
+
+/// <summary>Bounded native ADD initializer, replacing a particle normal.</summary>
+class SetVectorAttributeToVectorExpression : ParticleFunctionInitializer
+{
+    private readonly IVectorProvider input1;
+    private readonly IVectorProvider input2;
+
+    public SetVectorAttributeToVectorExpression(ParticleDefinitionParser parse) : base(parse)
+    {
+        // Installed constructor: output Normal=21, expression ADD=0,
+        // set method REPLACE=0, normalized output=false. Other modes are withheld.
+        if (parse.ParticleField("m_nOutputField", ParticleField.Normal) != ParticleField.Normal
+            || parse.Enum<VectorExpression>("m_nExpression", VectorExpression.VECTOR_EXPRESSION_ADD) != VectorExpression.VECTOR_EXPRESSION_ADD
+            || parse.Enum<ParticleSetMethod>("m_nSetMethod", ParticleSetMethod.PARTICLE_SET_REPLACE_VALUE) != ParticleSetMethod.PARTICLE_SET_REPLACE_VALUE
+            || parse.Boolean("m_bNormalizedOutput"))
+            throw new NotSupportedException("Vector expression initializer requires ADD, Normal, replacement, without normalization");
+        input1 = parse.VectorProvider("m_vInput1", new LiteralVectorProvider(Vector3.Zero));
+        input2 = parse.VectorProvider("m_vInput2", new LiteralVectorProvider(Vector3.Zero));
+    }
+
+    public override ulong WrittenFields => FieldMask(ParticleField.Normal);
+
+    public override Particle Initialize(ref Particle particle, ParticleCollection particles, ParticleSystemState state)
+    {
+        var a = input1.NextVector(ref particle, state);
+        var b = input2.NextVector(ref particle, state);
+        particle.Normal = a + b;
+        return particle;
+    }
+}
