@@ -0,0 +1,58 @@
+using Microsoft.Extensions.Logging;
+using ValveResourceFormat.Particles.Utils;
+using ValveResourceFormat.ResourceTypes;
+
+namespace ValveResourceFormat.Particles.Operators
+{
+    /// <summary>Writes a particle-position run to matching children and their descendants.</summary>
+    class SetChildControlPoints : ParticleFunctionOperator
+    {
+        private readonly int ChildGroupId;
+        private readonly int FirstControlPoint;
+        private readonly int NumControlPoints;
+        private readonly bool Reverse;
+        private readonly bool Supported;
+        private readonly List<ParticleSystemState> MatchingChildren = [];
+
+        public SetChildControlPoints(ParticleDefinitionParser parse) : base(parse)
+        {
+            ChildGroupId = parse.Int32("m_nChildGroupID", 0);
+            FirstControlPoint = parse.Int32("m_nFirstControlPoint", 0);
+            var requestedCount = parse.Int32("m_nNumControlPoints", 1);
+            var firstSourcePoint = parse.NumberProvider("m_nFirstSourcePoint", new LiteralNumberProvider(0f));
+            Reverse = parse.Boolean("m_bReverse", false);
+            Supported = FirstControlPoint is >= 0 and <= 63 && requestedCount >= 0
+                && firstSourcePoint is LiteralNumberProvider literal && literal.Value == 0f
+                && !parse.Boolean("m_bSetOrientation", false);
+            NumControlPoints = Supported ? Math.Min(requestedCount, 64 - FirstControlPoint) : 0;
+
+            if (!Supported)
+            {
+                parse.Logger.LogWarning("C_OP_SetChildControlPoints requires position-only literal source 0 and control points in 0..63");
+            }
+        }
+
+        public override void Operate(ParticleCollection particles, float frameTime, ParticleSystemState particleSystemState, float strength)
+        {
+            if (!Supported || particleSystemState.Data == null)
+            {
+                return;
+            }
+
+            MatchingChildren.Clear();
+            particleSystemState.Data.CollectChildStatesInGroup(ChildGroupId, MatchingChildren);
+            var live = particles.Current;
+            var count = Math.Min(NumControlPoints, live.Length);
+
+            for (var i = 0; i < count; i++)
+            {
+                var index = Reverse ? live.Length - 1 - i : i;
+                var position = live[index].Position;
+                foreach (var child in MatchingChildren)
+                {
+                    child.WriteAuthoredChildPosition(FirstControlPoint + i, position);
+                }
+            }
+        }
+    }
+}
