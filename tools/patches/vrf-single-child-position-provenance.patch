diff --git a/ValveResourceFormat/Particles/AuthoredRootPositionSummary.tla b/ValveResourceFormat/Particles/AuthoredRootPositionSummary.tla
new file mode 100644
--- /dev/null
+++ b/ValveResourceFormat/Particles/AuthoredRootPositionSummary.tla
@@ -0,0 +1,18 @@
+------------------- MODULE AuthoredRootPositionSummary -------------------
+EXTENDS Integers, TLC
+\* ParticleSystemState.WriteAuthoredChildTransform records root writes separately
+\* from its existing descendant writer. The new SetSingleControlPointPosition
+\* caller is child-only. Existing child writer/compaction models own propagation;
+\* arithmetic/once/reset are checked by the actual host oracle, not this model.
+VARIABLES count, written, reported, childWritten
+vars == <<count,written,reported,childWritten>>
+Init == /\ count=0 /\ written=FALSE /\ reported=FALSE /\ childWritten=FALSE
+Write(node) == /\ count<2 /\ node \in {0,1} /\ count'=count+1
+               /\ written'=(written \/ node=0)
+               /\ reported'=(reported \/ node=0)
+               /\ childWritten'=(childWritten \/ node=1)
+Terminal == /\ count=2 /\ UNCHANGED vars
+Next == (\E node \in {0,1}: Write(node)) \/ Terminal
+Spec == Init /\ [][Next]_vars
+ExactRootSummary == written=reported
+============================================================================
diff --git a/ValveResourceFormat/Particles/AuthoredRootPositionSummary.cfg b/ValveResourceFormat/Particles/AuthoredRootPositionSummary.cfg
